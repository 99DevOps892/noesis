#region [Local LLM Management]
function Get-LocalLLMs {
    <#
    .SYNOPSIS
    Detects and manages local LLM installations (Qwen3, Gemma3, Llama3)
    #>
    $llms = @()
    
    $searchPaths = @(
        "$env:USERPROFILE\.ollama\models",
        "$env:USERPROFILE\AppData\Local\Programs\Ollama",
        "C:\Program Files\Ollama",
        "$env:USERPROFILE\.lmstudio",
        "$env:USERPROFILE\AppData\Local\LM-Studio"
    )
    
    $models = @{
        "Qwen3" = @("qwen3", "qwen2.5", "qwen")
        "Gemma3" = @("gemma3", "gemma2", "gemma")
        "Llama3" = @("llama3", "llama3.1", "llama2", "llama")
    }
    
    foreach ($path in $searchPaths) {
        if (Test-Path $path) {
            foreach ($modelFamily in $models.Keys) {
                foreach ($modelName in $models[$modelFamily]) {
                    $searchPattern = "*$modelName*"
                    $found = Get-ChildItem -Path $path -Recurse -Filter $searchPattern -ErrorAction SilentlyContinue
                    if ($found) {
                        $llms += [PSCustomObject]@{
                            Family = $modelFamily
                            Name = $modelName
                            Path = $found[0].FullName
                            Status = "Available"
                        }
                    }
                }
            }
        }
    }
    
    if ($llms.Count -eq 0) {
        Write-Warning "⚠️ No local LLMs found. Attempting to detect via API endpoints..."
        
        # Check Ollama API
        try {
            $ollamaCheck = Invoke-RestMethod -Uri "http://localhost:11434/api/tags" -Method Get -TimeoutSec 5 -ErrorAction SilentlyContinue
            if ($ollamaCheck.models) {
                foreach ($model in $ollamaCheck.models) {
                    $family = switch -Wildcard ($model.name) {
                        "*qwen*" { "Qwen3" }
                        "*gemma*" { "Gemma3" }
                        "*llama*" { "Llama3" }
                        default { "Unknown" }
                    }
                    $llms += [PSCustomObject]@{
                        Family = $family
                        Name = $model.name
                        Path = "Ollama API"
                        Status = "Available via API"
                    }
                }
            }
        } catch {
            Write-Warning "Ollama API not available"
        }
    }
    
    return $llms
}

function Select-OptimalLLM {
    param(
        [Parameter(Mandatory)]
        [array]$AvailableLLMs
    )
    
    $preference = @("Qwen3", "Gemma3", "Llama3")
    $selected = $null
    
    foreach ($pref in $preference) {
        $selected = $AvailableLLMs | Where-Object { $_.Family -eq $pref } | Select-Object -First 1
        if ($selected) { break }
    }
    
    if (!$selected -and $AvailableLLMs) {
        $selected = $AvailableLLMs[0]
    }
    
    return $selected
}
