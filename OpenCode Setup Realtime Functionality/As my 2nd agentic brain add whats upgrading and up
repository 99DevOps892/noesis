                -ContentType "application/json" `
                -ErrorAction SilentlyContinue
            
            Write-Host "✅ $model thinking mode activated" -ForegroundColor Green
            
        } catch {
            Write-Warning "⚠️ Failed to configure $model: $_" -ForegroundColor Yellow
        }
    }
    
    # Configure OpenClaw to use thinking models
    $openClawConfig = "$env:USERPROFILE\.openclaw\config.json"
    if (Test-Path $openClawConfig) {
        $config = Get-Content $openClawConfig | ConvertFrom-Json
        
        # Update plugin configuration with thinking models
        if ($config.plugins.entries."local-llm".config.providers) {
            foreach ($provider in $config.plugins.entries."local-llm".config.providers) {
                $thinkingModel = "${provider.model}-thinking"
                $provider.model = $thinkingModel
                $provider.thinkingEnabled = $true
                $provider.reasoningDepth = "deep"
            }
            $config | ConvertTo-Json -Depth 10 | Set-Content $openClawConfig
        }
    }
    
    Write-Host "✅ All LLMs configured for thinking mode" -ForegroundColor Green
}

