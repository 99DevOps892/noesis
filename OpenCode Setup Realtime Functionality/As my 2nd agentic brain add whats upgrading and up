function Initialize-OpenClawGateway {
    <#
    .SYNOPSIS
    Fixes OpenClaw Gateway binding to enable mobile QR connection
    #>
    
    Write-Host "🔧 Configuring OpenClaw Gateway for Mobile Access..." -ForegroundColor Cyan
    
    # OpenClaw configuration paths
    $openClawPaths = @(
        "$env:USERPROFILE\.openclaw",
        "$env:USERPROFILE\AppData\Local\OpenClaw",
        "$env:PROGRAMDATA\OpenClaw",
        "$env:USERPROFILE\Documents\OpenClaw"
    )
    
    # Find OpenClaw config
    $configFile = $null
    foreach ($path in $openClawPaths) {
        $testPath = Join-Path $path "config.json"
        if (Test-Path $testPath) {
            $configFile = $testPath
            break
        }
        $testPath = Join-Path $path "settings.json"
        if (Test-Path $testPath) {
            $configFile = $testPath
            break
        }
    }
    
    if ($configFile) {
        Write-Host "📁 Found OpenClaw config: $configFile" -ForegroundColor Green
        
        # Read and modify config
        $config = Get-Content $configFile | ConvertFrom-Json
        
        # Fix Gateway binding - CRITICAL for QR code
        if (-not $config.gateway) { $config | Add-Member -MemberType NoteProperty -Name "gateway" -Value @{} }
        $config.gateway.bind = "lan"  # Change from "loopback" to "lan"
        
        # Enable Tailscale for secure access
        if (-not $config.tailscale) { $config | Add-Member -MemberType NoteProperty -Name "tailscale" -Value @{} }
        $config.tailscale.enabled = $true
        $config.tailscale.serve = $true
        
        # Configure device pairing
        if (-not $config.plugins) { $config | Add-Member -MemberType NoteProperty -Name "plugins" -Value @{} }
        if (-not $config.plugins.entries) { $config.plugins | Add-Member -MemberType NoteProperty -Name "entries" -Value @{} }
        if (-not $config.plugins.entries."device-pair") { 
            $config.plugins.entries | Add-Member -MemberType NoteProperty -Name "device-pair" -Value @{} 
        }
        if (-not $config.plugins.entries."device-pair".config) { 
            $config.plugins.entries."device-pair" | Add-Member -MemberType NoteProperty -Name "config" -Value @{} 
        }
        $config.plugins.entries."device-pair".config.publicUrl = "https://openclaw-${env:COMPUTERNAME}.tailscale.ts.net"
        
        # Save config
        $config | ConvertTo-Json -Depth 10 | Set-Content $configFile
        
        Write-Host "✅ Gateway configured for mobile access" -ForegroundColor Green
        
        # Restart OpenClaw service
        Restart-OpenClawService
        
