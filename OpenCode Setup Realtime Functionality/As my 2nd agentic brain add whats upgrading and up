#region [Message Processing]
function Send-AgentMessage {
    <#
    .SYNOPSIS
    Sends messages through configured channels
    #>
    param(
        [string]$Message,
        [string]$Target = "all",
        [string]$Channel = "whatsapp"
    )
    
    $messageId = [Guid]::NewGuid().ToString()
    $timestamp = Get-Date -Format "yyyy-MM-dd HH:mm:ss"
    
    # Log message
    $logEntry = @{
        MessageId = $messageId
        Message = $Message
        Target = $Target
        Channel = $Channel
        Timestamp = $timestamp
    }
    
    $logPath = "$($Global:Config.LogPath)\message_log.json"
    $currentLog = if (Test-Path $logPath) { 
        Get-Content $logPath | ConvertFrom-Json 
    } else { @() }
    
    $currentLog += $logEntry
    $currentLog | ConvertTo-Json | Set-Content $logPath
    
    Write-Host "💬 Message Sent ($channel): $Message" -ForegroundColor Magenta
    
    return $messageId
}

function Process-IncomingMessages {
    <#
    .SYNOPSIS
    Processes incoming messages from all channels
    #>
    param(
        [switch]$Continuous
    )
    
    do {
        try {
            # Check local agent for messages
            $agentMessages = try {
                $url = "$($Global:Config.LocalAgent)&action=poll"
                $response = Invoke-RestMethod -Uri $url -Method Get -TimeoutSec 5 -ErrorAction SilentlyContinue
                if ($response.messages) { $response.messages }
            } catch { $null }
            
            if ($agentMessages) {
                foreach ($msg in $agentMessages) {
                    Write-Host "📨 Received from Agent: $($msg.content)" -ForegroundColor Yellow
                    
                    # Process message with LLM
                    $response = Process-WithLLM -Message $msg.content
                    if ($response) {
                        Send-AgentMessage -Message $response -Target "agent"
                    }
                }
            }
            
            if ($Continuous) {
                Start-Sleep -Seconds 5
            }
            
        } catch {
            Write-Warning "Message processing error: $_"
            if ($Continuous) { Start-Sleep -Seconds 10 }
        }
    } while ($Continuous)
}

function Process-WithLLM {
    <#
    .SYNOPSIS
    Processes messages through local LLM
    #>
    param(
        [string]$Message,
        [string]$LLMProvider = "auto"
    )
    
    try {
        $llms = Get-LocalLLMs
        
        if ($llms.Count -eq 0) {
            Write-Warning "No local LLMs found. Using fallback response."
            return "I'm currently operating in fallback mode. Please ensure local LLMs are installed."
        }
        
        $selectedLLM = Select-OptimalLLM -AvailableLLMs $llms
        
        Write-Host "🧠 Processing with $($selectedLLM.Family): $($selectedLLM.Name)" -ForegroundColor Cyan
        
        # Use Ollama API if available
        try {
            $ollamaPayload = @{
                model = $selectedLLM.Name
                prompt = $Message
                stream = $false
            } | ConvertTo-Json
            
            $response = Invoke-RestMethod -Uri "http://localhost:11434/api/generate" `
                -Method Post `
                -Body $ollamaPayload `
                -ContentType "application/json" `
                -TimeoutSec 30 `
                -ErrorAction Stop
            
            return $response.response
        } catch {
            # Fallback to simple response
            return "I've received your message: '$Message'. Processing through $($selectedLLM.Family)."
        }
        
    } catch {
        Write-Error "LLM processing failed: $_"
        return "Error processing message. Please try again."
    }
}
