    }
}

function Generate-OpenClawQRCode {
    <#
    .SYNOPSIS
    Generates QR code for mobile device pairing
    #>
    
    Write-Host "📱 Generating Mobile Pairing QR Code..." -ForegroundColor Cyan
    
    # Get local IP addresses
    $ipAddresses = Get-NetIPAddress -AddressFamily IPv4 | Where-Object { $_.IPAddress -ne "127.0.0.1" } | Select-Object -ExpandProperty IPAddress
    
    # Generate pairing URLs
    $baseUrl = "http://localhost:18789"
    $lanUrls = $ipAddresses | ForEach-Object { "http://${_}:18789" }
    $tailscaleUrl = "https://openclaw-${env:COMPUTERNAME}.tailscale.ts.net"
    
    $pairingData = @{
        urls = @($baseUrl) + $lanUrls + @($tailscaleUrl)
        session = "agent:main:main"
        timestamp = Get-Date -Format "yyyy-MM-ddTHH:mm:ss"
        device = $env:COMPUTERNAME
    }
    
    # Save pairing data
    $pairingPath = "$env:USERPROFILE\.openclaw\pairing.json"
    $pairingData | ConvertTo-Json | Set-Content $pairingPath
    
    # Generate QR code using PowerShell
    try {
        # Install QRCode module if not available
        if (-not (Get-Module -Name QRCodeGenerator -ListAvailable)) {
            Install-Module -Name QRCodeGenerator -Force -Scope CurrentUser -ErrorAction SilentlyContinue
        }
        
        Import-Module QRCodeGenerator -Force -ErrorAction SilentlyContinue
        
        $qrContent = $pairingData.urls | ForEach-Object { "$_/chat?session=agent%3Amain%3Amain" } | Join-String -Separator "`n"
        $qr = ConvertTo-QRCode -Text $qrContent -Size 10
        $qrPath = "$env:USERPROFILE\Desktop\OpenClaw_QR_Code.png"
        $qr | Export-QRCode -Path $qrPath -Format PNG
        
        Write-Host "✅ QR Code generated: $qrPath" -ForegroundColor Green
        Write-Host "📱 Scan this QR code with OpenClaw mobile app" -ForegroundColor Yellow
        
        # Open the QR code image
        Invoke-Item $qrPath
        
        return $qrPath
        
    } catch {
        Write-Warning "⚠️ QR Code generation failed. Using text-based URL instead:"
        Write-Host "`n📱 Connect using these URLs:" -ForegroundColor Cyan
        $pairingData.urls | ForEach-Object { 
            Write-Host "  • $_/chat?session=agent%3Amain%3Amain" -ForegroundColor Gray 
        }
        Write-Host "`n💡 Use Tailscale for secure remote access: $tailscaleUrl" -ForegroundColor Yellow
    }
}

