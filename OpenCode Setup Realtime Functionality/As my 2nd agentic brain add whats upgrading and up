#region [Task Automation]
function Invoke-AgenticTask {
    <#
    .SYNOPSIS
    Executes agentic tasks with real-time monitoring
    #>
    param(
        [string]$Task,
        [hashtable]$Parameters = @{}
    )
    
    $taskId = [Guid]::NewGuid().ToString()
    
    Write-Host "⚡ Starting Agentic Task: $Task" -ForegroundColor Yellow
    
    $taskResult = [PSCustomObject]@{
        TaskId = $taskId
        Task = $Task
        Parameters = $Parameters
        Status = "Running"
        StartTime = Get-Date
        EndTime = $null
        Result = $null
        Channel = "WhatsApp"
        Contact = $Global:Config.WhatsAppNumber
        Repositories = @()
    }
    
    # Execute task based on type
    switch -Wildcard ($Task) {
        "*github*" {
            $githubConn = Connect-GitHubRealTime
            if ($githubConn) {
                $taskResult.Repositories = $githubConn.Repositories | ForEach-Object { $_.name }
                $taskResult.Result = "GitHub monitoring active for $($githubConn.Repositories.Count) repositories"
                $taskResult.Status = "Completed"
            }
        }
        "*agent*" {
            $agentConn = Connect-DeepSeekAgent
            if ($agentConn) {
                $taskResult.Result = "DeepSeek agent connected. Session: $($agentConn.SessionId)"
                $taskResult.Status = "Completed"
            }
        }
        "*whatsapp*" {
            $waConn = Connect-WhatsAppChannel
            if ($waConn) {
                $taskResult.Result = "WhatsApp channel ready: $($waConn.PhoneNumber)"
                $taskResult.Status = "Completed"
            }
        }
        "*all*" {
            # Run all connections
            $results = @()
            $results += Connect-DeepSeekAgent
            $results += Connect-GitHubRealTime
            $results += Connect-WhatsAppChannel
            $taskResult.Result = "All systems connected. $($results.Count) services active"
            $taskResult.Status = "Completed"
        }
        default {
            # Generic task processing with LLM
            $llmResponse = Process-WithLLM -Message "Task: $Task. Parameters: $($Parameters | ConvertTo-Json)"
            $taskResult.Result = $llmResponse
            $taskResult.Status = "Completed"
        }
    }
    
    $taskResult.EndTime = Get-Date
    
    # Log task result
    $taskPath = "$($Global:Config.LogPath)\tasks.json"
    $currentTasks = if (Test-Path $taskPath) { 
        Get-Content $taskPath | ConvertFrom-Json 
    } else { @() }
    
    $currentTasks += $taskResult
    $currentTasks | ConvertTo-Json -Depth 10 | Set-Content $taskPath
    
    Write-Host "✅ Task $($taskResult.TaskId) completed in $([math]::Round(($taskResult.EndTime - $taskResult.StartTime).TotalSeconds, 2))s" -ForegroundColor Green
    
    return $taskResult
}

