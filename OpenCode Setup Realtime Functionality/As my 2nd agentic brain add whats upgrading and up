function Test-OpenClawSystem {
    <#
    .SYNOPSIS
    Tests the complete OpenClaw system
    #>
    
    Write-Host "🧪 Running system tests..." -ForegroundColor Cyan
    
    $tests = @(
        @{ Name = "Gateway"; Test = { Test-OpenClawGateway } },
        @{ Name = "LLM Thinking"; Test = { Test-LLMThinking -Query "What is 15 * 23? Show your reasoning step by step." } },
        @{ Name = "QR Generation"; Test = { Generate-OpenClawQRCode } },
        @{ Name = "Mobile Pairing"; Test = { Test-OpenClawMobilePairing } }
    )
    
    $passed = 0
    foreach ($test in $tests) {
        try {
            Write-Host "  Testing $($test.Name)..." -ForegroundColor Gray
            $result = & $test.Test
            if ($result) {
                Write-Host "  ✅ $($test.Name) passed" -ForegroundColor Green
                $passed++
            } else {
                Write-Host "  ❌ $($test.Name) failed" -ForegroundColor Red
            }
        } catch {
            Write-Host "  ❌ $($test.Name) error: $_" -ForegroundColor Red
        }
    }
    
    Write-Host "`n📊 Test Results: $passed/$($tests.Count) passed" -ForegroundColor Yellow
}

function Test-OpenClawGateway {
    try {
        $response = Invoke-RestMethod -Uri "http://localhost:18789/health" -Method Get -TimeoutSec 5
        return $true
    } catch {
        return $false
    }
}

function Test-OpenClawMobilePairing {
    try {
        $pairingData = Get-Content "$env:USERPROFILE\.openclaw\pairing.json" | ConvertFrom-Json
        return $pairingData.urls.Count -gt 0
    } catch {
        return $false
    }
}

