    foreach ($model in $models) {
        try {
            Write-Host "⚙️ Configuring $model for thinking mode..." -ForegroundColor Yellow
            
            # Create model with thinking parameters
            $modelfile = @"
FROM $model
PARAMETER temperature 0.5
PARAMETER top_p 0.9
PARAMETER top_k 40
PARAMETER repeat_penalty 1.1
PARAMETER num_ctx 4096
PARAMETER num_predict 2048
PARAMETER stop ""
PARAMETER stop " answer"
PARAMETER stop " explanation"
SYSTEM """You are an AI assistant with advanced reasoning capabilities. 
Always show your thinking process step by step.
Use chain-of-thought reasoning for complex problems.
Break down problems into smaller steps.
Explain your reasoning before giving the final answer.
Be thorough and analytical in your approach.
Format your responses with clear thinking markers.
"""
"@
            
            $modelfilePath = "$env:TEMP\${model}_thinking.modelfile"
            $modelfile | Set-Content $modelfilePath
            
            # Create model with thinking enabled
            $result = Invoke-RestMethod -Uri "http://localhost:11434/api/create" `
